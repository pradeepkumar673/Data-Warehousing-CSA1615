% Create at least 10 transactions; run Apriori and FP-Growth with identical support/confidence, then identify common and unique rules.

@relation market_transactions

@attribute Bread {T,F}
@attribute Milk {T,F}
@attribute Eggs {T,F}
@attribute Butter {T,F}
@attribute Juice {T,F}

@data
T,T,F,T,F
T,T,T,F,T
F,T,T,T,F
T,F,T,F,T
T,T,F,T,T
F,T,T,F,F
T,T,T,T,F
T,F,F,T,T
T,T,F,F,T
F,T,T,T,T
