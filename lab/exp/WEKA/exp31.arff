% Create vehicle-classification ARFF data (EnginePower, Weight, Mileage, VehicleType); apply J48 and inspect rules.

@relation vehicle_classification

@attribute EnginePower numeric
@attribute Weight numeric
@attribute Mileage numeric
@attribute VehicleType {Hatchback,Sedan,SUV}

